  PURCHASE_ORDER
  PURCHASE_REMINDER
  STOCK_TRANSFER
}

enum GoodsReceiptStatus {
  DRAFT
  CONFIRMED
}

model GoodsReceiptItem {
  id               String    @id @default(cuid())
  receiptId        String
  itemId           String
  quantity         Decimal   @db.Decimal(15, 3)
  damagedQuantity  Decimal   @default(0) @db.Decimal(15, 3)
  missingQuantity  Decimal   @default(0) @db.Decimal(15, 3)
  costPrice        Decimal?  @db.Decimal(15, 6)
  purchaseQuantity Decimal   @db.Decimal(15, 3)
  purchaseUnit     String
  purchaseUnitCost Decimal?  @db.Decimal(15, 2)
  lineTotal        Decimal?  @db.Decimal(15, 2)
  packSizeSnapshot Decimal? @db.Decimal(15, 4)
  batchNumber      String?
  expiryDate       DateTime?
  batchId          String?

  receipt GoodsReceipt  @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  item    InventoryItem @relation(fields: [itemId], references: [id])

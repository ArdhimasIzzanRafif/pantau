# Contoh saja: isi nilai asli di environment hosting, jangan commit file .env.
# Gunakan PostgreSQL terkelola yang dapat dijangkau server hosting.
DATABASE_URL=
# Koneksi langsung untuk migrasi Prisma; boleh kosong untuk PostgreSQL tanpa pooler.
DIRECT_URL=
NEXTAUTH_SECRET=
AUTH_TRUST_HOST=true

# Isi ketiga URL dengan origin HTTPS temporary domain yang sama.
NEXTAUTH_URL=
NEXT_PUBLIC_APP_URL=
APP_URL=
NEXT_PUBLIC_APP_NAME=Pantau

# Email admin platform dan SMTP Gmail (App Password).
SUPER_ADMIN_EMAIL=
ADMIN_NOTIFY_EMAIL=
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Kunci AES-256 berupa 64 digit hex. Simpan tetap jika memindahkan DB lama.
WHATSAPP_ENCRYPTION_KEY=
# Matikan pengiriman selama tahap awal pengujian.
WHATSAPP_OUTBOUND_ENABLED=false
WHATSAPP_ALLOWED_NUMBERS=
OWNER_PHONE=
CRON_SECRET=
# off bila memakai scheduler eksternal, on untuk worker server Node.js.
OUTBOX_WORKER=on

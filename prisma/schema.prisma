generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── TENANT ───────────────────────────────────────────────────────────────────

model Organization {
  id                   String    @id @default(cuid())
  name                 String
  slug                 String    @unique
  logoUrl              String?
  qrisImageUrl         String?
  qrisPayload          String?
  ownerPhone           String?
  receiptLogoUrl       String?
  receiptWifiName      String?
  receiptWifiPassword  String?
  receiptFooterText    String?
  rolePermissions      Json?
  /// Berapa lama stok boleh ditahan reservasi sebelum ditandai terlambat.
  reservationHoldHours Int       @default(48)
  orderCounter         Int       @default(0)
  plan                 Plan      @default(FREE)
  status               OrgStatus @default(TRIAL)
  registrationAttempts Int       @default(1)
  trialEndsAt          DateTime?
  lastActiveAt         DateTime?
  suspendedAt          DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  users                       OrganizationUser[]
  locations                   Location[]
  inventoryItems              InventoryItem[]
  inventorySettings           InventoryLocationSetting[]
  stockBalances               StockBalance[]
  stockMovements              StockMovement[]
  stockBatches                StockBatch[]
  stockAdjustments            StockAdjustment[]
  stockTransfers              StockTransfer[]
  goodsReceipts               GoodsReceipt[]
  suppliers                   Supplier[]
  stockOpnames                StockOpname[]
  alerts                      Alert[]
  auditLogs                   AuditLog[]
  posShifts                   POSShift[]
  posOrders                   POSOrder[]
  modifierGroups              MenuModifierGroup[]
  discountRules               DiscountRule[]
  tables                      Table[]
  itemSuppliers               ItemSupplier[]
  purchaseRequests            PurchaseRequest[]
  purchaseOrders              PurchaseOrder[]
  incomingWhatsAppMessages    IncomingWhatsAppMessage[]
  supplierPhones              SupplierPhone[]
  purchaseOrderDocuments      PurchaseOrderDocument[]
  supplierMessageStatusEvents SupplierMessageStatusEvent[]
  whatsappIntegration         OrganizationWhatsApp?
  whatsAppOutbox              WhatsAppOutbox[]
  stockReservations           StockReservation[]
  productionRecipes           ProductionRecipe[]
  productions                 InventoryProduction[]
}

model OrganizationWhatsApp {
  organizationId         String    @id
  encryptedToken         String
  encryptedWebhookSecret String?
  senderPhone            String    @unique
  webhookConfiguredAt    DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

enum Plan {
  FREE
  STARTER
  PRO
  ENTERPRISE
}

enum OrgStatus {
  PENDING
  REJECTED
  TRIAL
  ACTIVE
  SUSPENDED
  CANCELLED
  EXPIRED
}

// ─── USER & AUTH ──────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  organizations      OrganizationUser[]
  accounts           Account[]
  sessions           Session[]
  posShiftsAsCashier POSShift[]         @relation("ShiftCashier")
  posOrdersAsCashier POSOrder[]         @relation("OrderCashier")
}

model OrganizationUser {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  role           Role
  createdAt      DateTime @default(now())

  organization      Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedLocations UserLocation[]

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
}

model UserLocation {
  id         String @id @default(cuid())
  orgUserId  String
  locationId String

  orgUser  OrganizationUser @relation(fields: [orgUserId], references: [id], onDelete: Cascade)
  location Location         @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([orgUserId, locationId])
  @@index([orgUserId])
}

enum Role {
  OWNER
  ADMIN_GUDANG
  SUPERVISOR
  KASIR
}

// ─── AUTH (NextAuth) ──────────────────────────────────────────────────────────

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// ─── LOCATION ─────────────────────────────────────────────────────────────────

model Location {
  id                     String       @id @default(cuid())
  organizationId         String
  name                   String
  type                   LocationType
  address                String?
  whatsappPhone          String?
  fulfillmentWarehouseId String?
  isActive               Boolean      @default(true)
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt

  organization         Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fulfillmentWarehouse Location?                  @relation("OutletFulfillmentWarehouse", fields: [fulfillmentWarehouseId], references: [id], onDelete: SetNull)
  servedOutlets        Location[]                 @relation("OutletFulfillmentWarehouse")
  stockBalances        StockBalance[]
  stockMovements       StockMovement[]
  stockBatches         StockBatch[]
  stockAdjustments     StockAdjustment[]
  inventorySettings    InventoryLocationSetting[]
  transfersFrom        StockTransfer[]            @relation("TransferFrom")
  transfersTo          StockTransfer[]            @relation("TransferTo")
  goodsReceipts        GoodsReceipt[]
  opnames              StockOpname[]
  menuToken            String                     @unique @default(cuid())
  posShifts            POSShift[]
  posOrders            POSOrder[]
  assignedUsers        UserLocation[]
  tables               Table[]
  discountRules        DiscountRuleLocation[]
  itemSuppliers        ItemSupplier[]
  purchaseRequests     PurchaseRequest[]
  purchaseOrders       PurchaseOrder[]
  stockReservations    StockReservation[]
  productions          InventoryProduction[]

  @@index([organizationId])
  @@index([fulfillmentWarehouseId])
}

enum LocationType {
  WAREHOUSE
  OUTLET
}

// ─── INVENTORY ────────────────────────────────────────────────────────────────

model InventoryItem {
  id               String   @id @default(cuid())
  organizationId   String
  name             String
  sku              String?
  category         String?
  /// Satuan DASAR bahan ini. Seluruh stok, ambang, dan reservasi memakai
  /// satuan ini, apa pun satuan yang diketik pengguna.
  unit             String   @default("pcs")
  /// Berapa satuan dasar dalam satu satuan kemasan. Desimal, bukan bilangan
  /// bulat, karena ada konversi seperti 1 botol = 0,75 liter.
  packSize         Decimal? @db.Decimal(15, 4)
  packUnit         String?
  costPrice        Decimal? @db.Decimal(15, 6)
  sellPrice        Decimal? @db.Decimal(15, 2)
  minStock         Decimal? @db.Decimal(15, 3)
  isTrackable      Boolean  @default(true)
  isMenuItem       Boolean  @default(false)
  isActive         Boolean  @default(true)
  isAvailableForQr Boolean  @default(true)
  description      String?
  imageUrl         String?
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  organization     Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stockBalances    StockBalance[]
  stockMovements   StockMovement[]
  stockBatches     StockBatch[]
  stockAdjustments StockAdjustment[]
  transferItems    StockTransferItem[]
  receiptItems     GoodsReceiptItem[]
  opnameItems      StockOpnameItem[]
  locationSettings InventoryLocationSetting[]
  recipeItems      RecipeItem[]               @relation("ParentItem")
  usedInRecipes    RecipeItem[]               @relation("ChildItem")
  posOrderItems    POSOrderItem[]
  modifierGroups   InventoryItemModifier[]
  modifierRecipes  ModifierRecipeItem[]
  discountRules    DiscountRuleItem[]
  itemSuppliers    ItemSupplier[]
  purchaseRequests PurchaseRequest[]
  reservations     StockReservation[]
  productionRecipe ProductionRecipe?        @relation("ProductionOutput")
  productionInputs ProductionIngredient[]   @relation("ProductionInput")
  productions      InventoryProduction[]

  @@unique([organizationId, sku])
  @@index([organizationId])
}

model InventoryLocationSetting {
  id             String   @id @default(cuid())
  organizationId String
  itemId         String
  locationId     String
  minStock       Decimal? @db.Decimal(15, 3)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  item         InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  location     Location      @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, itemId, locationId])
  @@index([organizationId, locationId])
}

model StockBalance {
  id             String   @id @default(cuid())
  organizationId String
  itemId         String
  locationId     String
  quantity       Decimal  @default(0) @db.Decimal(15, 3)
  updatedAt      DateTime @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  item         InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  location     Location      @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([itemId, locationId])
  @@index([organizationId, locationId])
}

// ─── STOCK MOVEMENTS (immutable audit trail) ─────────────────────────────────

model StockMovement {
  id             String       @id @default(cuid())
  organizationId String
  itemId         String
  locationId     String
  type           MovementType
  quantity       Decimal      @db.Decimal(15, 3)
  note           String?
  referenceId    String?
  createdById    String?
  batchId        String?
  affectsBalance Boolean      @default(true)
  effectiveAt    DateTime     @default(now())
  createdAt      DateTime     @default(now())

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  item         InventoryItem @relation(fields: [itemId], references: [id])
  location     Location      @relation(fields: [locationId], references: [id])
  batch        StockBatch?   @relation(fields: [batchId], references: [id], onDelete: SetNull)

  @@index([organizationId, itemId, effectiveAt])
  @@index([organizationId, locationId, effectiveAt])
  @@index([batchId])
}

enum MovementType {
  GOODS_IN
  GOODS_OUT
  TRANSFER_OUT
  TRANSFER_IN
  TRANSFER_RETURN
  TRANSFER_VARIANCE
  OPNAME_CORRECTION
  WASTE
  DAMAGE
  LOSS
  COMPLIMENTARY
  EXPIRED
  INITIAL_STOCK
  POS_SALE
  PRODUCTION_IN
  PRODUCTION_OUT
}

// Resep produksi terpisah dari resep menu: POS hanya mengurangi hasil olahan.
model ProductionRecipe {
  id             String   @id @default(cuid())
  organizationId String
  outputItemId   String   @unique
  yieldQuantity  Decimal  @db.Decimal(15, 3)
  weightPerPiece Decimal? @db.Decimal(15, 3)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  outputItem   InventoryItem          @relation("ProductionOutput", fields: [outputItemId], references: [id])
  ingredients  ProductionIngredient[]
  productions  InventoryProduction[]

  @@index([organizationId])
}

model ProductionIngredient {
  id           String  @id @default(cuid())
  recipeId     String
  itemId       String
  quantity     Decimal @db.Decimal(15, 3)

  recipe ProductionRecipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  item   InventoryItem    @relation("ProductionInput", fields: [itemId], references: [id])

  @@unique([recipeId, itemId])
}

model InventoryProduction {
  id             String   @id @default(cuid())
  organizationId String
  recipeId       String
  outputItemId   String
  locationId     String
  requestId      String
  quantity       Decimal  @db.Decimal(15, 3)
  totalCost      Decimal  @db.Decimal(15, 6)
  unitCost       Decimal  @db.Decimal(15, 6)
  ingredients    Json
  outputName     String
  outputUnit     String
  weightPerPiece Decimal? @db.Decimal(15, 3)
  note           String?
  createdById    String
  createdAt      DateTime @default(now())

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  recipe       ProductionRecipe @relation(fields: [recipeId], references: [id])
  outputItem   InventoryItem    @relation(fields: [outputItemId], references: [id])
  location     Location         @relation(fields: [locationId], references: [id])

  @@unique([organizationId, requestId])
  @@index([organizationId, createdAt])
}

model StockBatch {
  id              String    @id @default(cuid())
  organizationId  String
  itemId          String
  locationId      String
  batchNumber     String
  expiryDate      DateTime?
  receivedAt      DateTime  @default(now())
  initialQuantity Decimal   @db.Decimal(15, 3)
  quantity        Decimal   @db.Decimal(15, 3)
  costPrice       Decimal?  @db.Decimal(15, 6)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  organization    Organization                   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  item            InventoryItem                  @relation(fields: [itemId], references: [id])
  location        Location                       @relation(fields: [locationId], references: [id])
  receiptItems    GoodsReceiptItem[]
  movements       StockMovement[]
  adjustments     StockAdjustment[]
  transferSources StockTransferBatchAllocation[] @relation("TransferSourceBatch")

  @@unique([organizationId, itemId, locationId, batchNumber])
  @@index([organizationId, locationId, expiryDate])
  @@index([organizationId, itemId, quantity])
}

model StockAdjustment {
  id             String         @id @default(cuid())
  organizationId String
  locationId     String
  itemId         String
  type           AdjustmentType
  quantity       Decimal        @db.Decimal(15, 3)
  unitCost       Decimal?       @db.Decimal(15, 2)
  totalCost      Decimal?       @db.Decimal(15, 2)
  note           String
  evidenceUrl    String?
  batchId        String?
  createdById    String?
  createdAt      DateTime       @default(now())

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  location     Location      @relation(fields: [locationId], references: [id])
  item         InventoryItem @relation(fields: [itemId], references: [id])
  batch        StockBatch?   @relation(fields: [batchId], references: [id], onDelete: SetNull)

  @@index([organizationId, locationId, createdAt])
  @@index([organizationId, itemId, createdAt])
  @@index([batchId])
}

enum AdjustmentType {
  WASTE
  DAMAGE
  LOSS
  COMPLIMENTARY
  EXPIRED
}

// ─── GOODS RECEIPT (barang masuk) ────────────────────────────────────────────

model GoodsReceipt {
  id                String             @id @default(cuid())
  organizationId    String
  locationId        String
  supplierId        String?
  receiptNumber     String?
  supplier          String?
  notes             String?
  status            GoodsReceiptStatus @default(DRAFT)
  imageUrl          String?
  receivedAt        DateTime           @default(now())
  createdById       String?
  purchaseRequestId String?
  purchaseOrderId   String?
  clientRequestId   String?            @unique
  /// Barang pesanan diterima sebelum supplier mengonfirmasi (jalur darurat).
  withoutConfirmationReason String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  organization    Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  location        Location           @relation(fields: [locationId], references: [id])
  supplierRecord  Supplier?          @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  purchaseRequest PurchaseRequest?   @relation(fields: [purchaseRequestId], references: [id], onDelete: SetNull)
  purchaseOrder   PurchaseOrder?     @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  items           GoodsReceiptItem[]

  @@index([organizationId, locationId])
  @@index([organizationId, supplierId])
  @@index([purchaseRequestId])
  @@index([purchaseOrderId])
}

model Supplier {
  id                           String   @id @default(cuid())
  organizationId               String
  name                         String
  contactPerson                String?
  phone                        String?
  normalizedPhone              String?
  email                        String?
  address                      String?
  notes                        String?
  responseTimeoutMinutes       Int      @default(120)
  urgentResponseTimeoutMinutes Int      @default(30)
  isActive                     Boolean  @default(true)
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt

  organization             Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  goodsReceipts            GoodsReceipt[]
  itemSuppliers            ItemSupplier[]
  purchaseRequests         PurchaseRequest[]
  purchaseOrders           PurchaseOrder[]
  incomingWhatsAppMessages IncomingWhatsAppMessage[]
  /// Nomor WA tambahan (mis. admin supplier). Balasan dari nomor ini dianggap dari supplier.
  extraPhones              SupplierPhone[]

  @@unique([organizationId, name])
  @@unique([organizationId, normalizedPhone])
  @@index([organizationId, isActive])
}

model ItemSupplier {
  id               String   @id @default(cuid())
  organizationId   String
  itemId           String
  locationId       String
  supplierId       String
  priority         Int      @default(1)
  /// Nama bahan seperti yang dikenal supplier ("keju slice"). Kosong = nama di Pantau.
  supplierItemName String?
  /// Satuan beli ke supplier ("dus") dan isinya dalam satuan dasar bahan
  /// (1 dus = 100 pcs). Kosong = memesan dalam satuan dasar.
  purchaseUnit     String?
  purchaseUnitSize Decimal? @db.Decimal(15, 4)
  createdAt        DateTime @default(now())

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  item         InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  location     Location      @relation(fields: [locationId], references: [id], onDelete: Cascade)
  supplier     Supplier      @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([itemId, locationId, supplierId])
  @@unique([itemId, locationId, priority])
  @@index([organizationId, itemId, locationId, priority])
}

/// Kepala pesanan ke satu supplier untuk satu gudang, berisi banyak bahan.
/// Setiap bahan adalah satu PurchaseRequest (baris) dengan purchaseOrderId ini,
/// sehingga aturan per bahan (penerimaan, eskalasi, kebutuhan beli) tetap sama.
/// Satu WA pesanan dikirim per kepala pesanan; status WA disalin ke barisnya.
model PurchaseOrder {
  id             String                 @id @default(cuid())
  organizationId String
  supplierId     String
  locationId     String
  /// Kode pendek di WA, mis. "DBE6". Unik per organisasi.
  shortCode      String
  message        String
  urgency        PurchaseRequestUrgency @default(NORMAL)
  notes          String?
  createdById    String?
  createdAt      DateTime               @default(now())
  /// Dipesan di luar Pantau (mis. lewat WA pribadi owner); tidak ada WA dikirim.
  isManual            Boolean   @default(false)
  /// Dikonfirmasi manusia (mis. supplier konfirmasi lewat telepon).
  manualConfirmedAt   DateTime?
  manualConfirmedById String?
  manualConfirmNote   String?
  /// Balasan otomatis "format belum terbaca" hanya sekali per pesanan.
  autoReplySentAt     DateTime?
  /// WA "perlu dicek" ke penanggung jawab gudang terakhir dikirim (dibatasi).
  reviewNoticeAt      DateTime?

  organization     Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplier         Supplier                  @relation(fields: [supplierId], references: [id])
  location         Location                  @relation(fields: [locationId], references: [id])
  lines            PurchaseRequest[]
  goodsReceipts    GoodsReceipt[]
  documents        PurchaseOrderDocument[]
  incomingMessages IncomingWhatsAppMessage[]

  @@unique([organizationId, shortCode])
  @@index([organizationId, createdAt])
  @@index([supplierId])
}

model PurchaseRequest {
  id                      String                        @id @default(cuid())
  organizationId          String
  itemId                  String
  locationId              String
  supplierId              String
  priority                Int
  quantity                Decimal                       @db.Decimal(15, 3)
  receivedQuantity        Decimal                       @default(0) @db.Decimal(15, 3)
  message                 String
  status                  PurchaseRequestStatus         @default(ACTIVE)
  messageStatus           WhatsAppDeliveryStatus        @default(PENDING)
  messageAttempts         Int                           @default(0)
  lastMessageError        String?
  providerMessageId       String?
  messageSentAt           DateTime?
  lastMessageAt           DateTime?
  providerDeliveryStatus  SupplierMessageDeliveryStatus @default(UNKNOWN)
  providerStatusRaw       String?
  providerStateRaw        String?
  providerStateId         String?
  deliveryStatusUpdatedAt DateTime?
  deliveredAt             DateTime?
  readAt                  DateTime?
  undeliveredAt           DateTime?
  urgency                 PurchaseRequestUrgency        @default(NORMAL)
  responseTimeoutMinutes  Int                           @default(120)
  responseDueAt           DateTime?
  responseOverdueAt       DateTime?
  reminderCount           Int                           @default(0)
  lastReminderAt          DateTime?
  lastReminderStatus      WhatsAppDeliveryStatus?
  lastReminderError       String?
  createdAt               DateTime                      @default(now())
  resolvedAt              DateTime?
  resolvedById            String?
  resolutionNote          String?
  escalatedFromId         String?                       @unique
  procurementChainId      String?
  orderCode               String                        @unique
  supplierReplyStatus     SupplierReplyStatus           @default(WAITING)
  inputQuantity           Decimal?                      @db.Decimal(15, 3)
  inputUnit               String?
  conversionFactor        Decimal?                      @db.Decimal(15, 4)
  baseUnit                String?
  promisedQuantity        Decimal?                      @db.Decimal(15, 3)
  shippedQuantity         Decimal?                      @db.Decimal(15, 3)
  supplierLastMessage     String?
  supplierLastMessageAt   DateTime?
  supplierConfirmedAt     DateTime?
  supplierShippedAt       DateTime?
  /// Pesanan banyak bahan tempat baris ini berada. Kosong = pesanan lama
  /// berisi satu bahan (dan hasil eskalasi), yang dikirim sendiri.
  purchaseOrderId         String?

  organization        Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  item                InventoryItem                @relation(fields: [itemId], references: [id])
  location            Location                     @relation(fields: [locationId], references: [id])
  supplier            Supplier                     @relation(fields: [supplierId], references: [id])
  purchaseOrder       PurchaseOrder?               @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  escalatedFrom       PurchaseRequest?             @relation("EskalasiPengadaan", fields: [escalatedFromId], references: [id], onDelete: SetNull)
  escalatedTo         PurchaseRequest?             @relation("EskalasiPengadaan")
  goodsReceipts       GoodsReceipt[]
  incomingMessages    IncomingWhatsAppMessage[]
  messageStatusEvents SupplierMessageStatusEvent[]

  @@index([organizationId, itemId, locationId, status])
  @@index([organizationId, messageStatus, createdAt])
  @@index([organizationId, providerDeliveryStatus, responseDueAt])
  @@index([purchaseOrderId])
}

model SupplierMessageStatusEvent {
  id                String                        @id @default(cuid())
  organizationId    String
  purchaseRequestId String
  eventKey          String                        @unique
  providerMessageId String?
  providerStateId   String?
  providerStatus    String?
  providerState     String?
  mappedStatus      SupplierMessageDeliveryStatus
  occurredAt        DateTime
  receivedAt        DateTime                      @default(now())
  payload           Json

  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  purchaseRequest PurchaseRequest @relation(fields: [purchaseRequestId], references: [id], onDelete: Cascade)

  @@index([organizationId, providerMessageId])
  @@index([organizationId, providerStateId])
  @@index([purchaseRequestId, occurredAt])
}

model IncomingWhatsAppMessage {
  id                String                @id @default(cuid())
  organizationId    String
  purchaseRequestId String?
  supplierId        String?
  eventKey          String                @unique
  providerInboxId   String?
  devicePhone       String
  senderPhone       String
  senderName        String?
  message           String
  receivedAt        DateTime
  processingStatus  IncomingMessageStatus @default(RECEIVED)
  processingNote    String?
  createdAt         DateTime              @default(now())
  /// Pesanan banyak bahan yang dituju pesan ini (bila diketahui).
  purchaseOrderId   String?
  /// Jenis isi menurut pembaca: STANDAR, SEBUT_BAHAN, BAYAR, TANYA, BASA_BASI, LAMPIRAN, TAK_DIKENAL.
  kind              String?
  /// Lampiran dari Fonnte (bila paketnya mengirim file).
  attachmentUrl     String?
  attachmentName    String?
  /// Usulan sistem untuk ditinjau manusia (tombol satu klik).
  suggestion        Json?
  reviewedById      String?
  reviewedAt        DateTime?
  reviewAction      String?

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  purchaseRequest PurchaseRequest? @relation(fields: [purchaseRequestId], references: [id], onDelete: SetNull)
  supplier        Supplier?        @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  purchaseOrder   PurchaseOrder?   @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)

  @@index([organizationId, processingStatus])
  @@index([purchaseOrderId, receivedAt])
  @@index([organizationId, receivedAt])
  @@index([purchaseRequestId, receivedAt])
  @@index([senderPhone, receivedAt])
}

model WhatsAppOutbox {
  id                String                 @id @default(cuid())
  organizationId    String
  aggregateType     WhatsAppAggregateType
  aggregateId       String
  targetPhone       String
  message           String
  idempotencyKey    String                 @unique
  status            WhatsAppDeliveryStatus @default(PENDING)
  attempts          Int                    @default(0)
  maxAttempts       Int                    @default(4)
  nextAttemptAt     DateTime               @default(now())
  lockedAt          DateTime?
  sendStartedAt     DateTime?
  providerMessageId String?
  lastError         String?
  sentAt            DateTime?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
  @@index([organizationId, aggregateType, aggregateId])
}

enum PurchaseRequestStatus {

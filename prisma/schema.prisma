  PARTIAL
  SHIPPED
  UNAVAILABLE
  NEEDS_REVIEW
}

enum WhatsAppDeliveryStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  UNCERTAIN
  DEAD
}

enum SupplierMessageDeliveryStatus {
  UNKNOWN
  PROVIDER_ACCEPTED
  WHATSAPP_SENT
  DELIVERED
  READ
  UNDELIVERED
}

enum IncomingMessageStatus {
  RECEIVED
  MATCHED

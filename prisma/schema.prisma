// ─── STOCK TRANSFER (gudang → outlet) ────────────────────────────────────────

model StockTransfer {
  id                    String                  @id @default(cuid())
  organizationId        String
  fromLocationId        String
  toLocationId          String
  status                TransferStatus          @default(PENDING)
  notes                 String?
  sentAt                DateTime?
  receivedAt            DateTime?
  createdById           String?
  approvedById          String?
  approvedAt            DateTime?
  approvalNotes         String?
  confirmedById         String?
  receiptImageUrl       String?
  receiptNotes          String?
  varianceResolution    String?
  autoReplenishment     Boolean                 @default(false)
  outletRequested       Boolean                 @default(false)
  // A rejected, unsubmitted need has no order quantity; snapshot prevents
  // reappearing until its outlet balance, threshold, or warehouse changes.
  needRejectionSnapshot Json?
  notificationStatus    WhatsAppDeliveryStatus?
  notificationAttempts  Int                     @default(0)
  notificationError     String?
  notificationSentAt    DateTime?
  notificationLastAt    DateTime?
  notificationMessageId String?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fromLocation Location            @relation("TransferFrom", fields: [fromLocationId], references: [id])
  toLocation   Location            @relation("TransferTo", fields: [toLocationId], references: [id])
  items        StockTransferItem[]
  reservations StockReservation[]

  @@index([organizationId, status])
  @@index([toLocationId, status])
  @@index([organizationId, notificationStatus, createdAt])
}

/// PENDING  = outlet meminta, gudang belum memutuskan
/// APPROVED = gudang menyetujui dan stoknya DIRESERVASI, belum berkurang
/// SENT     = barang berangkat, stok gudang berkurang, reservasi dipakai
/// RECEIVED = outlet menerima
/// REJECTED = ditolak atau dibatalkan; reservasi dilepas
enum TransferStatus {
  PENDING
  APPROVED
  SENT
  RECEIVED
  REJECTED
}

enum ReservationStatus {
  ACTIVE
  CONSUMED
  RELEASED
}

model StockReservation {
  id                  String            @id @default(cuid())
  organizationId      String
  locationId          String
  itemId              String
  stockTransferId     String
  /// Unik: satu baris transfer hanya boleh punya satu reservasi. Ini yang
  /// membuat klik persetujuan ganda tidak dapat menghasilkan dua alokasi.
  stockTransferItemId String            @unique
  quantity            Decimal           @db.Decimal(15, 3)
  status              ReservationStatus @default(ACTIVE)
  /// Batas waktu barang seharusnya sudah dikirim. Lewat dari ini, reservasinya
  /// ditandai TERLAMBAT di tampilan. Tidak pernah dilepas otomatis: stok yang
  /// sudah dijanjikan hanya boleh dilepas lewat keputusan manusia.
  expiresAt           DateTime
  createdAt           DateTime          @default(now())
  consumedAt          DateTime?
  releasedAt          DateTime?

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  location     Location          @relation(fields: [locationId], references: [id])
  item         InventoryItem     @relation(fields: [itemId], references: [id])
  transfer     StockTransfer     @relation(fields: [stockTransferId], references: [id], onDelete: Cascade)
  transferItem StockTransferItem @relation(fields: [stockTransferItemId], references: [id], onDelete: Cascade)

  @@index([organizationId, locationId, itemId, status])
  @@index([stockTransferId])
}

model StockTransferItem {
  id                      String   @id @default(cuid())
  transferId              String
  itemId                  String
  quantity                Decimal  @db.Decimal(15, 3)
  receivedQty             Decimal? @db.Decimal(15, 3)
  requestedQuantity       Decimal? @db.Decimal(15, 3)
  damagedQty              Decimal? @db.Decimal(15, 3)
  /// Jejak satuan yang diketik pengguna beserta faktor konversinya saat itu.
  /// Faktor disimpan sebagai snapshot supaya riwayat lama tidak ikut berubah
  /// ketika "1 box = 20 pcs" kelak diperbarui menjadi angka lain.
  inputQuantity           Decimal? @db.Decimal(15, 3)
  inputUnit               String?
  conversionFactor        Decimal? @db.Decimal(15, 4)
  /// Baris transfer lama yang sisa kebutuhannya dilanjutkan oleh baris ini.
  /// Unik: satu sisa kebutuhan hanya boleh melahirkan satu transfer lanjutan,
  /// sehingga muat ulang halaman atau klik ganda tidak menggandakannya.
  sourceOutstandingItemId String?  @unique
  /// Kebutuhan outlet yang BELUM terpenuhi setelah penerimaan: diminta 18,
  /// dikirim dan diterima baik 15, maka sisanya 3. Diisi saat penerimaan dan
  /// dinolkan ketika outlet mengajukan permintaan pengganti — supaya sisa
  /// kebutuhan tidak hilang hanya karena transfernya sudah RECEIVED, dan tidak
  /// pula terhitung dua kali.
  outstandingQty          Decimal? @db.Decimal(15, 3)

  transfer          StockTransfer                  @relation(fields: [transferId], references: [id], onDelete: Cascade)
  item              InventoryItem                  @relation(fields: [itemId], references: [id])
  batchAllocations  StockTransferBatchAllocation[]
  reservation       StockReservation?
  sourceOutstanding StockTransferItem?             @relation("SisaKebutuhan", fields: [sourceOutstandingItemId], references: [id], onDelete: SetNull)
  continuedBy       StockTransferItem?             @relation("SisaKebutuhan")
}

model StockTransferBatchAllocation {
  id             String    @id @default(cuid())
  transferItemId String
  sourceBatchId  String?
  batchNumber    String?
  expiryDate     DateTime?
  costPrice      Decimal?  @db.Decimal(15, 6)
  quantity       Decimal   @db.Decimal(15, 3)

  transferItem StockTransferItem @relation(fields: [transferItemId], references: [id], onDelete: Cascade)
  sourceBatch  StockBatch?       @relation("TransferSourceBatch", fields: [sourceBatchId], references: [id], onDelete: SetNull)

  @@index([transferItemId])
  @@index([sourceBatchId])
}

// ─── STOCK OPNAME ─────────────────────────────────────────────────────────────

model StockOpname {
  id             String       @id @default(cuid())
  organizationId String
  locationId     String
  periodStart    DateTime
  periodEnd      DateTime
  shift          String?
  status         OpnameStatus @default(DRAFT)
  notes          String?
  submittedAt    DateTime?
  reviewedAt     DateTime?
  reviewedById   String?
  reviewNotes    String?
  createdById    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  location     Location          @relation(fields: [locationId], references: [id])
  items        StockOpnameItem[]

  @@index([organizationId, locationId])
}

enum OpnameStatus {
  DRAFT
  SUBMITTED
  REVIEWED
  REJECTED
}

model StockOpnameItem {
  id                    String   @id @default(cuid())
  opnameId              String
  itemId                String
  systemQty             Decimal  @db.Decimal(15, 3)
  physicalQty           Decimal? @db.Decimal(15, 3)
  difference            Decimal? @db.Decimal(15, 3)
  estimatedLoss         Decimal? @db.Decimal(15, 2)
  /// Harga bahan saat opname disimpan. Snapshot ini menjaga nilai historis
  /// agar tidak ikut berubah ketika harga bahan diperbarui kemudian.
  unitCostSnapshot      Decimal? @db.Decimal(15, 6)
  /// Nilai absolut selisih, baik stok kurang maupun stok lebih.
  absoluteVarianceValue Decimal? @db.Decimal(15, 2)
  notes                 String?

  opname StockOpname   @relation(fields: [opnameId], references: [id], onDelete: Cascade)
  item   InventoryItem @relation(fields: [itemId], references: [id])

  @@index([opnameId])
}

// ─── POS UPLOAD & MAPPING ────────────────────────────────────────────────────

// ─── RECIPE / BOM ─────────────────────────────────────────────────────────────

model RecipeItem {
  id           String  @id @default(cuid())
  parentItemId String
  childItemId  String
  quantity     Decimal @db.Decimal(15, 3)

  parentItem InventoryItem @relation("ParentItem", fields: [parentItemId], references: [id], onDelete: Cascade)
  childItem  InventoryItem @relation("ChildItem", fields: [childItemId], references: [id])

  @@unique([parentItemId, childItemId])
}

// ─── MODIFIER MENU ────────────────────────────────────────────────────────────

model MenuModifierGroup {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  isRequired     Boolean  @default(false)
  maxSelect      Int      @default(1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  options      MenuModifierOption[]
  items        InventoryItemModifier[]

  @@index([organizationId])
}

model MenuModifierOption {
  id        String  @id @default(cuid())
  groupId   String
  name      String
  price     Decimal @default(0) @db.Decimal(15, 2)
  sortOrder Int     @default(0)

  group              MenuModifierGroup      @relation(fields: [groupId], references: [id], onDelete: Cascade)
  recipeItems        ModifierRecipeItem[]
  orderItemModifiers POSOrderItemModifier[]
}

model ModifierRecipeItem {
  id       String  @id @default(cuid())
  optionId String
  itemId   String
  quantity Decimal @db.Decimal(15, 3)

  option MenuModifierOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  item   InventoryItem      @relation(fields: [itemId], references: [id])

  @@unique([optionId, itemId])
  @@index([itemId])
}

model InventoryItemModifier {
  itemId     String
  groupId    String
  sortOrder  Int     @default(0)
  // Wajib/tidaknya ditentukan per menu: grup yang sama bisa wajib di satu menu
  // dan opsional di menu lain. Nilai di MenuModifierGroup hanya jadi default
  // saat grup baru dipasang ke sebuah menu.
  isRequired Boolean @default(false)

  item  InventoryItem     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  group MenuModifierGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([itemId, groupId])
}

// ─── DISCOUNT RULES ───────────────────────────────────────────────────────────

model DiscountRule {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  type           String // PERCENT | AMOUNT
  value          Decimal   @db.Decimal(15, 2)
  minPurchase    Decimal   @default(0) @db.Decimal(15, 2)
  isActive       Boolean   @default(true)
  sortOrder      Int       @default(0)
  scheduleMode   String    @default("RECURRING") // PERIOD = satu periode; RECURRING = jadwal harian/mingguan
  validDays      String? // comma-separated 0-6 (0=Min,1=Sen,...,6=Sab), null = setiap hari
  startsAt       DateTime? // null = berlaku sejak dibuat
  expiresAt      DateTime? // null = tanpa batas
  startMinute    Int? // menit sejak 00:00 waktu Jakarta (happy hour mulai), null = sepanjang hari
  endMinute      Int? // menit sejak 00:00 waktu Jakarta (happy hour selesai); < startMinute = lewat tengah malam
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  orders       POSOrder[]
  locations    DiscountRuleLocation[] // kosong = berlaku semua outlet
  items        DiscountRuleItem[] // kosong = berlaku ke seluruh belanja; terisi = hanya menu tsb

  @@index([organizationId, isActive])
}

model DiscountRuleLocation {
  id             String @id @default(cuid())
  discountRuleId String
  locationId     String

  discountRule DiscountRule @relation(fields: [discountRuleId], references: [id], onDelete: Cascade)
  location     Location     @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([discountRuleId, locationId])
  @@index([locationId])
}

model DiscountRuleItem {
  id             String @id @default(cuid())
  discountRuleId String
  menuItemId     String

  discountRule DiscountRule  @relation(fields: [discountRuleId], references: [id], onDelete: Cascade)
  menuItem     InventoryItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@unique([discountRuleId, menuItemId])
  @@index([menuItemId])
}

model Table {
  id             String   @id @default(cuid())
  organizationId String
  locationId     String
  name           String
  tableToken     String   @unique @default(cuid())
  isActive       Boolean  @default(true)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  location     Location     @relation(fields: [locationId], references: [id])

  @@index([organizationId, locationId])
  @@index([tableToken])
}

// ─── POS SYSTEM ───────────────────────────────────────────────────────────────

enum ShiftStatus {
  OPEN
  CLOSED
}

enum OrderType {
  DINE_IN
  TAKEAWAY
  DELIVERY
}

enum OrderStatus {
  PENDING_PAYMENT
  OPEN
  HELD
  PAID
  VOID
}

enum PaymentMethod {
  CASH
  QRIS
  TRANSFER
  CARD
  GOFOOD
  GRABFOOD
  SHOPEEFOOD
  OTHER
}

model POSShift {
  id             String      @id @default(cuid())
  organizationId String
  locationId     String
  cashierId      String
  shiftNumber    String
  openingBalance Decimal     @default(0) @db.Decimal(15, 2)
  closingBalance Decimal?    @db.Decimal(15, 2)
  expectedCash   Decimal?    @db.Decimal(15, 2)
  totalSales     Decimal     @default(0) @db.Decimal(15, 2)
  totalOrders    Int         @default(0)
  notes          String?
  openedAt       DateTime    @default(now())
  closedAt       DateTime?
  status         ShiftStatus @default(OPEN)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  location     Location     @relation(fields: [locationId], references: [id])
  cashier      User         @relation("ShiftCashier", fields: [cashierId], references: [id])
  orders       POSOrder[]

  @@index([organizationId, locationId, status])
}

model POSOrder {
  id                  String      @id @default(cuid())
  organizationId      String
  locationId          String
  shiftId             String?
  cashierId           String?
  orderNumber         String
  orderType           OrderType   @default(DINE_IN)
  tableNumber         String?
  customerName        String?
  status              OrderStatus @default(OPEN)
  subtotal            Decimal     @db.Decimal(15, 2)
  discountType        String?
  discountValue       Decimal     @default(0) @db.Decimal(15, 2)
  discountAmount      Decimal     @default(0) @db.Decimal(15, 2)
  discountLabel       String?
  discountRuleId      String?
  platformOrderNumber String?
  taxPercent          Decimal     @default(0) @db.Decimal(5, 2)
  taxAmount           Decimal     @default(0) @db.Decimal(15, 2)
  total               Decimal     @db.Decimal(15, 2)
  guestSessionId      String?
  notes               String?
  voidReason          String?
  paymentRef          String?
  paidAt              DateTime?
  /// HPP pada saat pembayaran, dihitung dari resep dan harga batch/bahan.
  cogsAmount          Decimal?    @db.Decimal(15, 2)
  /// False berarti ada komponen resep tanpa harga atau data historis hasil estimasi.
  cogsComplete        Boolean     @default(false)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  location     Location       @relation(fields: [locationId], references: [id])
  shift        POSShift?      @relation(fields: [shiftId], references: [id])
  cashier      User?          @relation("OrderCashier", fields: [cashierId], references: [id])
  discountRule DiscountRule?  @relation(fields: [discountRuleId], references: [id], onDelete: SetNull)
  items        POSOrderItem[]
  payments     POSPayment[]

  @@index([organizationId, locationId, createdAt])
  @@index([organizationId, status])
  @@index([shiftId])
  @@index([cashierId])
  @@index([guestSessionId])
}

model POSOrderItem {
  id         String  @id @default(cuid())
  orderId    String
  menuItemId String?
  name       String
  price      Decimal @db.Decimal(15, 2)
  qty        Int
  discount   Decimal @default(0) @db.Decimal(15, 2)
  subtotal   Decimal @db.Decimal(15, 2)
  notes      String?

  order     POSOrder               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem  InventoryItem?         @relation(fields: [menuItemId], references: [id], onDelete: SetNull)
  modifiers POSOrderItemModifier[]

  @@index([orderId])
}

model POSOrderItemModifier {
  id          String  @id @default(cuid())
  orderItemId String
  optionId    String?
  groupName   String
  optionName  String
  price       Decimal @default(0) @db.Decimal(15, 2)

  orderItem POSOrderItem        @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  option    MenuModifierOption? @relation(fields: [optionId], references: [id], onDelete: SetNull)

  @@index([orderItemId])
  @@index([optionId])
}

model POSPayment {
  id        String        @id @default(cuid())
  orderId   String
  method    PaymentMethod
  amount    Decimal       @db.Decimal(15, 2)
  change    Decimal       @default(0) @db.Decimal(15, 2)
  reference String?
  note      String?
  createdAt DateTime      @default(now())

  order POSOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

// ─── ALERTS ──────────────────────────────────────────────────────────────────

model Alert {
  id             String    @id @default(cuid())
  organizationId String
  type           AlertType
  severity       Severity  @default(WARNING)
  title          String
  message        String
  locationId     String?
  itemId         String?
  referenceId    String?
  isResolved     Boolean   @default(false)
  resolvedAt     DateTime?
  resolvedById   String?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, isResolved])
}

enum AlertType {
  STOCK_SHORTAGE
  STOCK_SURPLUS
  TRANSFER_REJECTED
  TRANSFER_COMPLETED
  ITEM_NO_COST_PRICE
  POS_ITEM_UNMAPPED
  LOW_STOCK
  PRICE_ANOMALY
  GOODS_RECEIVED
  OPNAME_COMPLETED
  TRANSFER_SENT
}

enum Severity {
  INFO
  WARNING
  CRITICAL
}

// ─── PLATFORM AUDIT LOG (admin aplikasi) ─────────────────────────────────────

model PlatformAuditLog {
  id         String   @id @default(cuid())
  adminEmail String
  action     String
  targetType String
  targetId   String?
  note       String?
  before     Json?
  after      Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([targetType, targetId])
}

// ─── AUDIT LOG ────────────────────────────────────────────────────────────────

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  userId         String?
  action         String
  entity         String
  entityId       String?
  before         Json?
  after          Json?
  ipAddress      String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([entity, entityId])
}

/// Nomor WA tambahan milik supplier (admin, sales, dll.). Unik per organisasi:
/// satu nomor tidak mungkin milik dua supplier.
model SupplierPhone {
  id             String   @id @default(cuid())
  organizationId String
  supplierId     String
  /// Sudah dinormalkan (62…).
  phone          String
  label          String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplier     Supplier     @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([organizationId, phone])
  @@index([supplierId])
}

/// Dokumen pesanan supplier: invoice, foto nota/resi/barang.
model PurchaseOrderDocument {
  id                String   @id @default(cuid())
  organizationId    String
  purchaseOrderId   String
  /// INVOICE | FOTO | LAINNYA
  kind              String
  url               String
  fileName          String?
  /// WA (dari balasan supplier) | UPLOAD (diunggah pengguna)
  source            String
  incomingMessageId String?
  uploadedById      String?
  createdAt         DateTime @default(now())

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  @@index([purchaseOrderId])
}
